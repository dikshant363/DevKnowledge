# Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database
# Primary async connection:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devknowledge
# Sync connection for Alembic migrations:
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/devknowledge
# Local SQLite fallback option for development / testing / offline:
# DATABASE_URL=sqlite+aiosqlite:///./devknowledge_dev.db
# DATABASE_URL_SYNC=sqlite:///./devknowledge_dev.db

# Queue & Cache
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Crawler & Sandbox
MAX_PAGES_PER_SOURCE=1000
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT_SECONDS=15
PLAYWRIGHT_HEADLESS=true
ALLOW_PRIVATE_IPS=false

# Storage
ARTIFACTS_DIR=./storage/artifacts
EXPORT_DIR=./storage/exports

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
